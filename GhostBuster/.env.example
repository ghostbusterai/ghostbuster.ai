# Copy to `.env` — Vite loads `.env` only; `.env.example` is documentation.

# Leave unset during local dev — Vite proxies /api and /compose to the API (port 3001).
# VITE_API_BASE=https://your-api.example.com

# Multi-user (Supabase) — from Project Settings → API:
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# For internal demos: Authentication → Providers → Email → disable "Confirm email".
