# Copy to .env and fill in values.

# Required for AI message composition (/compose). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — default claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional — default 3001
# PORT=3001

# Optional — default 0.0.0.0 (listen on all interfaces; use 127.0.0.1 to block LAN)
# HOST=0.0.0.0

# MongoDB (required). Local or Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/ghostbuster

# Session cookie signing secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional — import ghostbuster-server/data/app-data.json into the first Google user who signs in
# MIGRATE_LEGACY_JSON=1

# Google OAuth (sign-in + Calendar/Gmail). Enable Calendar API and Gmail API in Google Cloud Console.
# Add ALL redirect URIs below under Credentials → OAuth 2.0 Client → Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# —— Local Vite + API (recommended for development) ——
# Frontend: http://localhost:5173  → proxies /api to :3001
# Redirect URIs must hit the Vite origin so the session cookie sticks to :5173.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
APP_URL=http://localhost:5173

# —— Production (API serves the built UI from the same host) ——
# GOOGLE_LOGIN_REDIRECT_URI=https://your-app.onrender.com/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/google/callback
# APP_URL=https://your-app.onrender.com
# NODE_ENV=production
