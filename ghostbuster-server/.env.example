# Copy to .env and fill in values.

# Required for AI message composition (/compose). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — default 3001
# PORT=3001

# Optional — default 0.0.0.0 (listen on all interfaces; use 127.0.0.1 to block LAN)
# HOST=0.0.0.0

# Google Calendar (reminders sync). Create OAuth credentials at https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
# APP_URL=http://localhost:3001
