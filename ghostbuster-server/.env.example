# --- Multi-user mode (Supabase Postgres + JWT) ---
# If BOTH are set, the API uses Postgres and requires Authorization: Bearer <access_token>
# on /api/* and POST /compose. Omit both to keep the legacy single-file JSON store (no sign-in).
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # service_role key — server only; never expose to the browser
